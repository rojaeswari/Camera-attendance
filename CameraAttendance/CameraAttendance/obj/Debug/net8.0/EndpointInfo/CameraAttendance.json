        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ResponceDTO"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponceDTO"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponceDTO"
                }
