              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponceDTO"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponceDTO"
                }
              }
            }
          }
        }
      }
